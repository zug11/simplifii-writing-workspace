# Server-only OpenAI configuration. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra

# One shared early-access code. Server-only; never prefix with NEXT_PUBLIC_.
SIMPLIFII_INVITE_CODE=

# Random server-only signing secret (32+ characters) for expiring invite sessions.
SIMPLIFII_INVITE_SESSION_SECRET=

# Tester feedback -> Jira. Create the API token at
# https://id.atlassian.com/manage-profile/security/api-tokens. Leave unset and
# the feedback form tells testers it isn't configured yet, without erroring.
JIRA_EMAIL=a.saint-james@unsw.edu.au
JIRA_API_TOKEN=
JIRA_BASE_URL=https://simplifiiy.atlassian.net
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Task

# Every feedback issue is assigned to this address (email lookup against the
# same Jira site), so it reaches Jira's normal notification email. Must be a
# real user on the Jira site or the lookup returns nothing and no one gets
# assigned. Defaults to a.saint-james@unsw.edu.au, the verified account.
JIRA_NOTIFY_EMAIL=a.saint-james@unsw.edu.au
